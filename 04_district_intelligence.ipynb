    {
      "cell_type": "code",
      "source": [
        "high_digital_signal = (\n",
        "    signals[\"digital_emerging_signal_score\"] >= 65\n",
        ")\n",
        "\n",
        "high_support_context = (\n",
        "    signals[\"development_support_context_score\"] >= 60\n",
        ")\n",
        "\n",
        "conditions = [\n",
        "    # Constant series receive no digital score.\n",
        "    ~score_eligible,\n",
        "\n",
        "    # Digital score exists, but development context is incomplete.\n",
        "    signals[\n",
        "        \"development_support_context_score\"\n",
        "    ].isna(),\n",
        "\n",
        "    # Rising digital interest and higher support needs.\n",
        "    high_digital_signal & high_support_context,\n",
        "\n",
        "    # Rising digital interest with lower support needs.\n",
        "    high_digital_signal & ~high_support_context,\n",
        "\n",
        "    # Lower digital signal but higher development needs.\n",
        "    ~high_digital_signal & high_support_context,\n",
        "]\n",
        "\n",
        "categories = [\n",
        "    \"insufficient_digital_variation\",\n",
        "    \"digital_signal_only_context_incomplete\",\n",
        "    \"emerging_signal_support_priority\",\n",
        "    \"rising_digital_interest\",\n",
        "    \"development_context_monitoring\",\n",
        "]\n",
        "\n",
        "signals[\"signal_category\"] = np.select(\n",
        "    conditions,\n",
        "    categories,\n",
        "    default=\"stable_or_lower_digital_signal\",\n",
        ")\n",
        "\n",
        "driver_labels = {\n",
        "    \"short_term_signal_score\":\n",
        "        \"Recent three-month growth\",\n",
        "\n",
        "    \"annual_signal_score\":\n",
        "        \"Twelve-month growth\",\n",
        "\n",
        "    \"trend_slope_score\":\n",
        "        \"Recent trend slope\",\n",
        "\n",
        "    \"projected_change_score\":\n",
        "        \"Next-month projected change\",\n",
        "}\n",
        "\n",
        "\n",
        "def get_leading_components(row):\n",
        "    if row[\"signal_quality\"] == \"insufficient_variation\":\n",
        "        return \"Limited search-index variation\"\n",
        "\n",
        "    available_components = {\n",
        "        driver_labels[column]: row[column]\n",
        "        for column in digital_weights\n",
        "        if pd.notna(row[column])\n",
        "    }\n",
        "\n",
        "    ranked_components = sorted(\n",
        "        available_components,\n",
        "        key=available_components.get,\n",
        "        reverse=True,\n",
        "    )\n",
        "\n",
        "    return \"; \".join(ranked_components[:2])\n",
        "\n",
        "\n",
        "signals[\"leading_signal_components\"] = (\n",
        "    signals.apply(\n",
        "        get_leading_components,\n",
        "        axis=1,\n",
        "    )\n",
        ")\n",
        "\n",
        "# Confidence rules:\n",
        "# low    = constant/insufficient series\n",
        "# medium = limited variation, reviewed medium-confidence\n",
        "#          mapping, or incomplete context\n",
        "# high   = informative series with complete context\n",
        "signals[\"data_confidence\"] = np.select(\n",
        "    [\n",
        "        signals[\"signal_quality\"].eq(\n",
        "            \"insufficient_variation\"\n",
        "        ),\n",
        "\n",
        "        signals[\"signal_quality\"].eq(\n",
        "            \"limited_variation\"\n",
        "        )\n",
        "        | signals[\"mapping_confidence\"].eq(\"medium\")\n",
        "        | signals[\"context_component_count\"].lt(3),\n",
        "    ],\n",
        "    [\n",
        "        \"low\",\n",
        "        \"medium\",\n",
        "    ],\n",
        "    default=\"high\",\n",
        ")\n",
        "\n",
        "category_summary = (\n",
        "    signals[\"signal_category\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"signal_category\")\n",
        "    .reset_index(name=\"districts\")\n",
        ")\n",
        "\n",
        "confidence_summary = (\n",
        "    signals[\"data_confidence\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"data_confidence\")\n",
        "    .reset_index(name=\"districts\")\n",
        ")\n",
        "\n",
        "print(\"Signal categories:\")\n",
        "display(category_summary)\n",
        "\n",
        "print(\"Data confidence:\")\n",
        "display(confidence_summary)\n",
        "\n",
        "assert len(signals) == 151\n",
        "assert signals[\"series_id\"].is_unique\n",
        "assert signals[\"context_match\"].all()\n",
        "\n",
        "print(\"✓ Final district categories validated.\")"
      ],
