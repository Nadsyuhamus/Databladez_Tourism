    {
      "cell_type": "code",
      "source": [
        "from datetime import datetime, timezone\n",
        "import json\n",
        "\n",
        "ARTIFACT_DIR = WORK_DIR / \"ml/artifacts\"\n",
        "ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)\n",
        "\n",
        "output_columns = [\n",
        "    \"series_id\",\n",
        "    \"state\",\n",
        "    \"area\",\n",
        "    \"canonical_district\",\n",
        "    \"mapping_confidence\",\n",
        "\n",
        "    \"latest_observed_month\",\n",
        "    \"latest_observed_trend\",\n",
        "    \"observed_months\",\n",
        "    \"unique_trend_values\",\n",
        "\n",
        "    \"forecast_month\",\n",
        "    \"forecast_trend_index\",\n",
        "    \"forecast_method\",\n",
        "\n",
        "    \"recent_3m_mean\",\n",
        "    \"previous_3m_mean\",\n",
        "    \"short_term_change_pct\",\n",
        "\n",
        "    \"recent_12m_mean\",\n",
        "    \"previous_12m_mean\",\n",
        "    \"annual_change_pct\",\n",
        "    \"normalized_12m_slope_pct\",\n",
        "    \"projected_change_pct\",\n",
        "\n",
        "    \"short_term_signal_score\",\n",
        "    \"annual_signal_score\",\n",
        "    \"trend_slope_score\",\n",
        "    \"projected_change_score\",\n",
        "    \"digital_emerging_signal_score\",\n",
        "\n",
        "    \"population_000\",\n",
        "    \"population_000_year\",\n",
        "    \"income_median\",\n",
        "    \"income_median_year\",\n",
        "    \"poverty\",\n",
        "    \"poverty_year\",\n",
        "    \"u_rate\",\n",
        "    \"u_rate_year\",\n",
        "\n",
        "    \"context_component_count\",\n",
        "    \"development_support_context_score\",\n",
        "\n",
        "    \"signal_quality\",\n",
        "    \"signal_category\",\n",
        "    \"leading_signal_components\",\n",
        "    \"data_confidence\",\n",
        "]\n",
        "\n",
        "# Prevent an error if an optional forecast-method\n",
        "# column was unavailable.\n",
        "output_columns = [\n",
        "    column\n",
        "    for column in output_columns\n",
        "    if column in signals.columns\n",
        "]\n",
        "\n",
        "district_output = (\n",
        "    signals[output_columns]\n",
        "    .sort_values(\n",
        "        \"digital_emerging_signal_score\",\n",
        "        ascending=False,\n",
        "        na_position=\"last\",\n",
        "    )\n",
        "    .reset_index(drop=True)\n",
        ")\n",
        "\n",
        "csv_path = (\n",
        "    OUTPUT_DIR\n",
        "    / \"district_emerging_signals_latest.csv\"\n",
        ")\n",
        "\n",
        "json_path = (\n",
        "    OUTPUT_DIR\n",
        "    / \"district_emerging_signals_latest.json\"\n",
        ")\n",
        "\n",
        "metadata_path = (\n",
        "    ARTIFACT_DIR\n",
        "    / \"district_signal_metadata.json\"\n",
        ")\n",
        "\n",
        "district_output.to_csv(\n",
        "    csv_path,\n",
        "    index=False,\n",
        ")\n",
        "\n",
        "district_output.to_json(\n",
        "    json_path,\n",
        "    orient=\"records\",\n",
        "    indent=2,\n",
        "    date_format=\"iso\",\n",
        ")\n",
        "\n",
        "metadata = {\n",
        "    \"generated_at\": datetime.now(\n",
        "        timezone.utc\n",
        "    ).isoformat(),\n",
        "\n",
        "    \"output_name\": (\n",
        "        \"District emerging digital-demand signals\"\n",
        "    ),\n",
        "\n",
        "    \"district_count\": int(len(district_output)),\n",
        "\n",
        "    \"scored_district_count\": int(\n",
        "        district_output[\n",
        "            \"digital_emerging_signal_score\"\n",
        "        ].notna().sum()\n",
        "    ),\n",
        "\n",
        "    \"digital_signal_weights\": digital_weights,\n",
        "\n",
        "    \"development_context_weights\": context_weights,\n",
        "\n",
        "    \"thresholds\": {\n",
        "        \"high_digital_signal\": 65,\n",
        "        \"high_development_support_context\": 60,\n",
        "    },\n",
        "\n",
        "    \"signal_quality_rules\": {\n",
        "        \"insufficient_variation\": (\n",
        "            \"Fewer than 24 observations or only one \"\n",
        "            \"unique trend value\"\n",
        "        ),\n",
        "        \"limited_variation\": (\n",
        "            \"Exactly two unique trend values\"\n",
        "        ),\n",
        "        \"informative\": (\n",
        "            \"At least three unique trend values\"\n",
        "        ),\n",
        "    },\n",
        "\n",
        "    \"limitations\": [\n",
        "        (\n",
        "            \"Google Trends indices are normalized within \"\n",
        "            \"each series and do not represent visitor counts.\"\n",
        "        ),\n",
        "        (\n",
        "            \"The digital score measures changes in search \"\n",
        "            \"interest, not absolute tourism market size.\"\n",
        "        ),\n",
        "        (\n",
        "            \"The development context score is kept separate \"\n",
        "            \"from the digital-demand score.\"\n",
        "        ),\n",
        "        (\n",
        "            \"Socioeconomic indicators use their latest \"\n",
        "            \"available year and may differ by district.\"\n",
        "        ),\n",
        "        (\n",
        "            \"Three districts have insufficient socioeconomic \"\n",
        "            \"coverage for a development-context score.\"\n",
        "        ),\n",
        "        (\n",
        "            \"Categories are monitoring signals, not causal \"\n",
        "            \"claims or investment recommendations.\"\n",
        "        ),\n",
        "    ],\n",
        "}\n",
        "\n",
        "with open(\n",
        "    metadata_path,\n",
