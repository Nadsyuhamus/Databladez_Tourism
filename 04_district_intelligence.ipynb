        "context_indicators = [\n",
        "    \"population_000\",\n",
        "    \"income_median\",\n",
        "    \"poverty\",\n",
        "    \"u_rate\",\n",
        "    \"ep_ratio\",\n",
        "]\n",
        "\n",
        "district_context[\"year\"] = pd.to_numeric(\n",
        "    district_context[\"year\"],\n",
        "    errors=\"coerce\",\n",
        ")\n",
        "\n",
        "for column in context_indicators:\n",
        "    district_context[column] = pd.to_numeric(\n",
        "        district_context[column],\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "\n",
        "latest_context = crosswalk_output[\n",
        "    [\n",
        "        \"series_id\",\n",
        "        \"state\",\n",
        "        \"matched_context_district\",\n",
        "    ]\n",
        "].copy()\n",
        "\n",
        "for indicator in context_indicators:\n",
        "    latest_indicator = (\n",
        "        district_context\n",
        "        .dropna(subset=[indicator])\n",
        "        .sort_values(\"year\")\n",
        "        .groupby(\n",
        "            [\"state\", \"district\"],\n",
        "            as_index=False,\n",
        "        )\n",
        "        .tail(1)[\n",
        "            [\n",
        "                \"state\",\n",
        "                \"district\",\n",
        "                \"year\",\n",
        "                indicator,\n",
        "            ]\n",
        "        ]\n",
        "        .rename(\n",
        "            columns={\n",
        "                \"district\":\n",
        "                    \"matched_context_district\",\n",
        "\n",
        "                \"year\":\n",
        "                    f\"{indicator}_year\",\n",
        "            }\n",
        "        )\n",
        "    )\n",
        "\n",
        "    latest_context = latest_context.merge(\n",
        "        latest_indicator,\n",
        "        on=[\n",
        "            \"state\",\n",
        "            \"matched_context_district\",\n",
        "        ],\n",
        "        how=\"left\",\n",
        "        validate=\"one_to_one\",\n",
        "    )\n",
        "\n",
        "signals = signals.merge(\n",
        "    latest_context.drop(\n",
        "        columns=[\n",
        "            \"state\",\n",
        "            \"matched_context_district\",\n",
        "        ]\n",
        "    ),\n",
        "    on=\"series_id\",\n",
        "    how=\"left\",\n",
        "    validate=\"one_to_one\",\n",
        ")\n",
        "\n",
        "print(\"Latest context merged:\", len(signals))\n",
        "\n",
        "context_availability = pd.DataFrame(\n",
        "    {\n",
        "        \"indicator\": context_indicators,\n",
        "        \"available_districts\": [\n",
        "            int(signals[column].notna().sum())\n",
        "            for column in context_indicators\n",
        "        ],\n",
        "        \"missing_districts\": [\n",
        "            int(signals[column].isna().sum())\n",
        "            for column in context_indicators\n",
        "        ],\n",
        "    }\n",
        ")\n",
        "\n",
        "display(context_availability)"
      ],
