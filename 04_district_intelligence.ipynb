    {
      "cell_type": "code",
      "source": [
        "# Higher poverty = higher support-context score.\n",
        "signals[\"poverty_support_score\"] = (\n",
        "    percentile_score(\n",
        "        signals[\"poverty\"],\n",
        "        ascending=True,\n",
        "    )\n",
        ")\n",
        "\n",
        "# Lower median income = higher support-context score.\n",
        "signals[\"low_income_support_score\"] = (\n",
        "    percentile_score(\n",
        "        signals[\"income_median\"],\n",
        "        ascending=False,\n",
        "    )\n",
        ")\n",
        "\n",
        "# Higher unemployment = higher support-context score.\n",
        "signals[\"unemployment_support_score\"] = (\n",
        "    percentile_score(\n",
        "        signals[\"u_rate\"],\n",
        "        ascending=True,\n",
        "    )\n",
        ")\n",
        "\n",
        "context_weights = {\n",
        "    \"poverty_support_score\": 0.40,\n",
        "    \"low_income_support_score\": 0.35,\n",
        "    \"unemployment_support_score\": 0.25,\n",
        "}\n",
        "\n",
        "context_score_columns = list(context_weights)\n",
        "\n",
        "weighted_context = pd.DataFrame(\n",
        "    {\n",
        "        column: signals[column] * weight\n",
        "        for column, weight in context_weights.items()\n",
        "    }\n",
        ")\n",
        "\n",
        "available_weights = pd.DataFrame(\n",
        "    {\n",
        "        column: (\n",
        "            signals[column].notna().astype(float)\n",
        "            * weight\n",
        "        )\n",
        "        for column, weight in context_weights.items()\n",
        "    }\n",
        ")\n",
        "\n",
        "signals[\"context_component_count\"] = (\n",
        "    signals[context_score_columns]\n",
        "    .notna()\n",
        "    .sum(axis=1)\n",
        ")\n",
        "\n",
        "signals[\"development_support_context_score\"] = (\n",
        "    weighted_context.sum(\n",
        "        axis=1,\n",
        "        min_count=1,\n",
        "    )\n",
        "    / available_weights.sum(axis=1).replace(\n",
        "        0,\n",
        "        np.nan,\n",
        "    )\n",
        ")\n",
        "\n",
        "# At least two indicators are required.\n",
        "signals.loc[\n",
        "    signals[\"context_component_count\"] < 2,\n",
        "    \"development_support_context_score\",\n",
        "] = np.nan\n",
        "\n",
        "context_ready = (\n",
        "    signals[\"development_support_context_score\"]\n",
        "    .notna()\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Districts with usable development context:\",\n",
        "    context_ready,\n",
        ")\n",
        "\n",
        "display(\n",
        "    signals[\"context_component_count\"]\n",
        "    .value_counts()\n",
        "    .sort_index()\n",
        "    .rename_axis(\"available_components\")\n",
        "    .reset_index(name=\"districts\")\n",
        ")\n",
        "\n",
        "display(\n",
        "    signals[\"development_support_context_score\"]\n",
        "    .describe()\n",
        "    .round(2)\n",
        ")\n",
        "\n",
        "valid_context_scores = signals[\n",
        "    \"development_support_context_score\"\n",
        "].dropna()\n",
        "\n",
        "assert valid_context_scores.between(0, 100).all()\n",
        "\n",
        "if context_ready < 140:\n",
        "    raise ValueError(\n",
        "        \"Development-context coverage is unexpectedly low.\"\n",
        "    )\n",
        "\n",
        "print(\"✓ Development-support context calculated.\")"
      ],
