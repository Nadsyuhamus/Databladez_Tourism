      "source": [
        "def find_column(frame, candidates):\n",
        "    for column in candidates:\n",
        "        if column in frame.columns:\n",
        "            return column\n",
        "\n",
        "    raise KeyError(\n",
        "        f\"None of these columns were found: {candidates}\\n\"\n",
        "        f\"Available columns: {frame.columns.tolist()}\"\n",
        "    )\n",
        "\n",
        "\n",
        "forecast_value_column = find_column(\n",
        "    forecast,\n",
        "    [\n",
        "        \"forecast_trend_index\",\n",
        "        \"forecast_value\",\n",
        "        \"predicted_trend_index\",\n",
        "        \"predicted_next_month\",\n",
        "        \"prediction\",\n",
        "        \"forecast\",\n",
        "    ],\n",
        ")\n",
        "\n",
        "forecast_month_column = find_column(\n",
        "    forecast,\n",
        "    [\n",
        "        \"forecast_month\",\n",
        "        \"target_month\",\n",
        "        \"prediction_month\",\n",
        "        \"next_month\",\n",
        "    ],\n",
        ")\n",
        "\n",
        "method_column = next(\n",
        "    (\n",
        "        column\n",
        "        for column in [\n",
        "            \"forecast_method\",\n",
        "            \"method\",\n",
        "            \"prediction_method\",\n",
        "            \"forecasting_method\",\n",
        "        ]\n",
        "        if column in forecast.columns\n",
        "    ),\n",
        "    None,\n",
        ")\n",
        "\n",
        "print(\"Forecast value column:\", forecast_value_column)\n",
        "print(\"Forecast month column:\", forecast_month_column)\n",
        "print(\"Method column:\", method_column)\n",
        "\n",
        "selected_columns = [\n",
        "    \"series_id\",\n",
        "    forecast_value_column,\n",
        "    forecast_month_column,\n",
        "]\n",
        "\n",
        "if method_column:\n",
        "    selected_columns.append(method_column)\n",
        "\n",
        "district_forecast_values = forecast.loc[\n",
        "    forecast[\"geo_level\"].eq(\"district_or_area\"),\n",
        "    selected_columns,\n",
        "].copy()\n",
        "\n",
        "rename_columns = {\n",
        "    forecast_value_column: \"forecast_trend_index\",\n",
        "    forecast_month_column: \"forecast_month\",\n",
        "}\n",
        "\n",
        "if method_column:\n",
        "    rename_columns[method_column] = \"forecast_method\"\n",
        "\n",
        "district_forecast_values = (\n",
        "    district_forecast_values.rename(\n",
        "        columns=rename_columns\n",
        "    )\n",
        ")\n",
        "\n",
        "district_forecast_values[\n",
        "    \"forecast_trend_index\"\n",
        "] = pd.to_numeric(\n",
        "    district_forecast_values[\n",
        "        \"forecast_trend_index\"\n",
        "    ],\n",
        "    errors=\"coerce\",\n",
        ")\n",
        "\n",
        "signals = (\n",
        "    crosswalk_output\n",
        "    .merge(\n",
        "        trend_indicators,\n",
        "        on=\"series_id\",\n",
        "        how=\"left\",\n",
        "        validate=\"one_to_one\",\n",
        "    )\n",
        "    .merge(\n",
        "        district_forecast_values,\n",
        "        on=\"series_id\",\n",
        "        how=\"left\",\n",
        "        validate=\"one_to_one\",\n",
        "    )\n",
        ")\n",
        "\n",
        "signals[\"projected_change_pct\"] = (\n",
        "    100\n",
        "    * (\n",
        "        signals[\"forecast_trend_index\"]\n",
        "        - signals[\"latest_observed_trend\"]\n",
        "    )\n",
        "    / signals[\n",
        "        \"latest_observed_trend\"\n",
        "    ].abs().clip(lower=1)\n",
        ")\n",
        "\n",
        "missing_history = (\n",
