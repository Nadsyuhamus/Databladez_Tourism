        "def percentile_score(\n",
        "    series,\n",
        "    eligible=None,\n",
        "    ascending=True,\n",
        "):\n",
        "    result = pd.Series(\n",
        "        np.nan,\n",
        "        index=series.index,\n",
        "        dtype=float,\n",
        "    )\n",
        "\n",
        "    if eligible is None:\n",
        "        eligible = pd.Series(\n",
        "            True,\n",
        "            index=series.index,\n",
        "        )\n",
        "\n",
        "    valid = eligible & series.notna()\n",
        "\n",
        "    if valid.sum() == 0:\n",
        "        return result\n",
        "\n",
        "    # Limit extreme values before ranking.\n",
        "    lower = series.loc[valid].quantile(0.05)\n",
        "    upper = series.loc[valid].quantile(0.95)\n",
        "\n",
        "    clipped = series.loc[valid].clip(\n",
        "        lower=lower,\n",
        "        upper=upper,\n",
        "    )\n",
        "\n",
        "    ranks = clipped.rank(\n",
        "        method=\"average\",\n",
        "        ascending=ascending,\n",
        "    )\n",
        "\n",
        "    if len(ranks) == 1:\n",
        "        result.loc[valid] = 50\n",
        "    else:\n",
        "        result.loc[valid] = (\n",
        "            (ranks - 1)\n",
        "            / (len(ranks) - 1)\n",
        "            * 100\n",
        "        )\n",
        "\n",
        "    return result\n",
        "\n",
        "\n",
        "# Include informative and limited-variation series.\n",
        "# Exclude only constant/insufficient series.\n",
        "score_eligible = signals[\"signal_quality\"].isin(\n",
        "    [\n",
        "        \"informative\",\n",
        "        \"limited_variation\",\n",
        "    ]\n",
        ")\n",
        "\n",
        "component_sources = {\n",
        "    \"short_term_signal_score\":\n",
        "        \"short_term_change_pct\",\n",
        "\n",
        "    \"annual_signal_score\":\n",
        "        \"annual_change_pct\",\n",
        "\n",
        "    \"trend_slope_score\":\n",
        "        \"normalized_12m_slope_pct\",\n",
        "\n",
        "    \"projected_change_score\":\n",
        "        \"projected_change_pct\",\n",
        "}\n",
        "\n",
        "for score_column, raw_column in component_sources.items():\n",
        "    signals[score_column] = percentile_score(\n",
        "        signals[raw_column],\n",
        "        eligible=score_eligible,\n",
        "        ascending=True,\n",
        "    )\n",
        "\n",
        "digital_weights = {\n",
        "    \"short_term_signal_score\": 0.35,\n",
        "    \"annual_signal_score\": 0.30,\n",
        "    \"trend_slope_score\": 0.20,\n",
        "    \"projected_change_score\": 0.15,\n",
        "}\n",
        "\n",
        "signals[\"digital_emerging_signal_score\"] = sum(\n",
        "    signals[column] * weight\n",
        "    for column, weight in digital_weights.items()\n",
        ")\n",
        "\n",
        "signals.loc[\n",
        "    ~score_eligible,\n",
        "    \"digital_emerging_signal_score\",\n",
        "] = np.nan\n",
        "\n",
        "scored_count = (\n",
        "    signals[\"digital_emerging_signal_score\"]\n",
        "    .notna()\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "unscored_count = (\n",
        "    signals[\"digital_emerging_signal_score\"]\n",
        "    .isna()\n",
        "    .sum()\n",
        ")\n",
        "\n",
        "print(\"Eligible series:\", int(score_eligible.sum()))\n",
        "print(\"Scored series:\", scored_count)\n",
        "print(\"Unscored constant series:\", unscored_count)\n",
        "\n",
        "display(\n",
        "    signals[\"digital_emerging_signal_score\"]\n",
        "    .describe()\n",
        "    .round(2)\n",
        ")\n",
        "\n",
        "assert int(score_eligible.sum()) == 116\n",
        "assert scored_count == 116\n",
        "assert unscored_count == 35\n",
        "\n",
        "valid_scores = signals[\n",
        "    \"digital_emerging_signal_score\"\n",
        "].dropna()\n",
        "\n",
        "assert valid_scores.between(0, 100).all()\n",
        "\n",
        "print(\"✓ Digital emerging-signal scores calculated.\")"
      ],
