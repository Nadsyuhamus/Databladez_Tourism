      "source": [
        "forecast_audit = pd.read_csv(\n",
        "    OUTPUT_DIR / \"demand_forecast_latest.csv\"\n",
        ")\n",
        "\n",
        "registry_audit = pd.read_csv(\n",
        "    OUTPUT_DIR / \"series_registry.csv\"\n",
        ")\n",
        "\n",
        "state_audit = pd.read_csv(\n",
        "    OUTPUT_DIR\n",
        "    / \"state_tourism_intelligence_latest.csv\"\n",
        ")\n",
        "\n",
        "crosswalk_audit = pd.read_csv(\n",
        "    OUTPUT_DIR / \"district_series_crosswalk.csv\"\n",
        ")\n",
        "\n",
        "district_audit = pd.read_csv(\n",
        "    OUTPUT_DIR\n",
        "    / \"district_emerging_signals_latest.csv\"\n",
        ")\n",
        "\n",
        "# Parse JSON files to confirm they are valid.\n",
        "with open(\n",
        "    OUTPUT_DIR / \"demand_forecast_latest.json\",\n",
        "    encoding=\"utf-8\",\n",
        ") as file:\n",
        "    json.load(file)\n",
        "\n",
        "with open(\n",
        "    OUTPUT_DIR\n",
        "    / \"state_tourism_intelligence_latest.json\",\n",
        "    encoding=\"utf-8\",\n",
        ") as file:\n",
        "    json.load(file)\n",
        "\n",
        "with open(\n",
        "    OUTPUT_DIR\n",
        "    / \"district_emerging_signals_latest.json\",\n",
        "    encoding=\"utf-8\",\n",
        ") as file:\n",
        "    json.load(file)\n",
        "\n",
        "with open(\n",
        "    ARTIFACT_DIR / \"model_metadata.json\",\n",
        "    encoding=\"utf-8\",\n",
        ") as file:\n",
        "    json.load(file)\n",
        "\n",
        "with open(\n",
        "    ARTIFACT_DIR / \"scoring_metadata.json\",\n",
        "    encoding=\"utf-8\",\n",
        ") as file:\n",
        "    json.load(file)\n",
        "\n",
        "with open(\n",
        "    ARTIFACT_DIR / \"district_signal_metadata.json\",\n",
        "    encoding=\"utf-8\",\n",
        ") as file:\n",
        "    json.load(file)\n",
        "\n",
        "print(\"Forecast rows:\", len(forecast_audit))\n",
        "print(\"Registry rows:\", len(registry_audit))\n",
        "print(\"State intelligence rows:\", len(state_audit))\n",
        "print(\"District crosswalk rows:\", len(crosswalk_audit))\n",
        "print(\"District signal rows:\", len(district_audit))\n",
        "\n",
        "assert len(forecast_audit) == 167\n",
        "assert len(registry_audit) == 167\n",
        "assert len(state_audit) == 16\n",
        "assert len(crosswalk_audit) == 151\n",
        "assert len(district_audit) == 151\n",
        "\n",
        "assert forecast_audit[\"series_id\"].is_unique\n",
        "assert registry_audit[\"series_id\"].is_unique\n",
        "assert crosswalk_audit[\"series_id\"].is_unique\n",
        "assert district_audit[\"series_id\"].is_unique\n",
        "\n",
        "assert set(crosswalk_audit[\"series_id\"]) == set(\n",
        "    district_audit[\"series_id\"]\n",
        ")\n",
        "\n",
        "assert set(district_audit[\"series_id\"]).issubset(\n",
        "    set(forecast_audit[\"series_id\"])\n",
        ")\n",
        "\n",
        "context_matches = (\n",
        "    crosswalk_audit[\"context_match\"]\n",
        "    .astype(str)\n",
        "    .str.lower()\n",
        "    .eq(\"true\")\n",
        ")\n",
        "\n",
        "assert context_matches.all()\n",
        "\n",
        "digital_scores = district_audit[\n",
        "    \"digital_emerging_signal_score\"\n",
        "]\n",
        "\n",
        "context_scores = district_audit[\n",
        "    \"development_support_context_score\"\n",
        "]\n",
        "\n",
        "assert digital_scores.notna().sum() == 116\n",
        "assert digital_scores.isna().sum() == 35\n",
        "assert context_scores.notna().sum() == 148\n",
        "assert context_scores.isna().sum() == 3\n",
        "\n",
        "assert np.isfinite(\n",
        "    digital_scores.dropna()\n",
        ").all()\n",
        "\n",
        "assert np.isfinite(\n",
        "    context_scores.dropna()\n",
        ").all()\n",
        "\n",
        "assert digital_scores.dropna().between(\n",
        "    0,\n",
        "    100,\n",
        ").all()\n",
        "\n",
        "assert context_scores.dropna().between(\n",
        "    0,\n",
        "    100,\n",
        ").all()\n",
        "\n",
        "print(\"\\nForecast geographic levels:\")\n",
        "\n",
        "display(\n",
        "    forecast_audit[\"geo_level\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"geo_level\")\n",
        "    .reset_index(name=\"series\")\n",
        ")\n",
        "\n",
        "print(\"District categories:\")\n",
        "\n",
        "display(\n",
        "    district_audit[\"signal_category\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"signal_category\")\n",
        "    .reset_index(name=\"districts\")\n",
        ")\n",
        "\n",
        "print(\"District confidence:\")\n",
        "\n",
        "display(\n",
        "    district_audit[\"data_confidence\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"data_confidence\")\n",
        "    .reset_index(name=\"districts\")\n",
        ")\n",
        "\n",
        "print(\"✓ Final output relationships validated.\")"
      ],
