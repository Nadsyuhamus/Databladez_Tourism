        "Step 19"
      ],
      "metadata": {
        "id": "NBA3Bqqwe5f4"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "import numpy as np\n",
        "import pandas as pd\n",
        "\n",
        "trends = pd.read_csv(\n",
        "    DATA_DIR / \"google_trends_monthly.csv\"\n",
        ")\n",
        "\n",
        "trends[\"month\"] = pd.to_datetime(\n",
        "    trends[\"month\"],\n",
        "    errors=\"coerce\",\n",
        ")\n",
        "\n",
        "trends[\"trend_index\"] = pd.to_numeric(\n",
        "    trends[\"trend_index\"],\n",
        "    errors=\"coerce\",\n",
        ")\n",
        "\n",
        "# Remove the duplicate-column records found during\n",
        "# the original data audit.\n",
        "if \"duplicate_column_flag\" in trends.columns:\n",
        "    duplicate_flag = pd.to_numeric(\n",
        "        trends[\"duplicate_column_flag\"],\n",
        "        errors=\"coerce\",\n",
        "    )\n",
        "\n",
        "    trends = trends.loc[\n",
        "        duplicate_flag.isna() | duplicate_flag.ne(2)\n",
        "    ].copy()\n",
        "\n",
        "district_trends = trends.loc[\n",
        "    trends[\"geo_level\"].eq(\"district_or_area\")\n",
        "].copy()\n",
        "\n",
        "district_trends[\"series_id\"] = (\n",
        "    district_trends[\"state\"].astype(str).str.strip()\n",
        "    + \" | \"\n",
        "    + district_trends[\"geo_level\"].astype(str).str.strip()\n",
        "    + \" | \"\n",
        "    + district_trends[\"area\"].astype(str).str.strip()\n",
        ")\n",
        "\n",
        "\n",
        "def percentage_change(new_value, old_value):\n",
        "    if pd.isna(new_value) or pd.isna(old_value):\n",
        "        return np.nan\n",
        "\n",
        "    return (\n",
        "        100\n",
        "        * (new_value - old_value)\n",
        "        / max(abs(old_value), 1)\n",
        "    )\n",
        "\n",
        "\n",
        "indicator_records = []\n",
        "\n",
        "for series_id, group in district_trends.groupby(\n",
        "    \"series_id\"\n",
        "):\n",
        "    group = (\n",
        "        group.sort_values(\"month\")\n",
        "        .dropna(subset=[\"month\", \"trend_index\"])\n",
        "    )\n",
        "\n",
        "    values = group[\"trend_index\"].astype(float)\n",
        "\n",
        "    recent_3 = values.tail(3)\n",
        "    previous_3 = values.iloc[-6:-3]\n",
        "\n",
        "    recent_12 = values.tail(12)\n",
        "    previous_12 = values.iloc[-24:-12]\n",
        "\n",
        "    recent_3_mean = recent_3.mean()\n",
        "    previous_3_mean = previous_3.mean()\n",
        "\n",
        "    recent_12_mean = recent_12.mean()\n",
        "    previous_12_mean = previous_12.mean()\n",
        "\n",
        "    if len(recent_12) >= 6:\n",
        "        x = np.arange(len(recent_12))\n",
        "\n",
        "        slope = np.polyfit(\n",
        "            x,\n",
        "            recent_12.to_numpy(),\n",
        "            1,\n",
        "        )[0]\n",
        "\n",
        "        normalized_slope = (\n",
        "            100\n",
        "            * slope\n",
        "            / max(abs(recent_12_mean), 1)\n",
        "        )\n",
        "    else:\n",
        "        normalized_slope = np.nan\n",
        "\n",
        "    unique_values = values.nunique()\n",
        "\n",
        "    indicator_records.append(\n",
        "        {\n",
        "            \"series_id\": series_id,\n",
        "            \"latest_observed_month\": group[\"month\"].max(),\n",
        "            \"latest_observed_trend\": values.iloc[-1],\n",
        "            \"observed_months\": len(values),\n",
        "            \"unique_trend_values\": unique_values,\n",
        "            \"recent_3m_mean\": recent_3_mean,\n",
        "            \"previous_3m_mean\": previous_3_mean,\n",
        "            \"short_term_change_pct\": percentage_change(\n",
        "                recent_3_mean,\n",
        "                previous_3_mean,\n",
        "            ),\n",
        "            \"recent_12m_mean\": recent_12_mean,\n",
        "            \"previous_12m_mean\": previous_12_mean,\n",
        "            \"annual_change_pct\": percentage_change(\n",
        "                recent_12_mean,\n",
        "                previous_12_mean,\n",
        "            ),\n",
        "            \"normalized_12m_slope_pct\": normalized_slope,\n",
        "            \"signal_quality\": (\n",
        "              \"insufficient_variation\"\n",
        "              if len(values) < 24 or unique_values <= 1\n",
        "              else (\n",
        "                  \"limited_variation\"\n",
        "                  if unique_values == 2\n",
        "                  else \"informative\"\n",
        "              )\n",
        "          ),\n",
        "        }\n",
        "    )\n",
        "\n",
        "trend_indicators = pd.DataFrame(indicator_records)\n",
        "\n",
        "print(\"Clean district trend rows:\", len(district_trends))\n",
        "print(\"District trend series:\", len(trend_indicators))\n",
        "\n",
        "quality_summary = (\n",
        "    trend_indicators[\"signal_quality\"]\n",
        "    .value_counts()\n",
        "    .rename_axis(\"signal_quality\")\n",
        "    .reset_index(name=\"series\")\n",
        ")\n",
        "\n",
        "display(quality_summary)\n",
        "\n",
        "assert len(trend_indicators) == 151\n",
        "\n",
        "print(\"✓ Historical district indicators created.\")"
      ],
